# GitDeck server configuration (copy to apps/server/.env or export in your shell)
PORT=4319
HOST=127.0.0.1
# Optional: custom data directory (defaults to <repo>/.gitdeck or ~/.gitdeck)
# GITDECK_HOME=
# Optional: path to the git executable (defaults to "git" on PATH)
# GIT_BIN=git
LOG_LEVEL=info
# Allowed CORS origin for the dev web app (comma separated)
CORS_ORIGIN=http://127.0.0.1:5188,http://localhost:5188
COMMAND_TIMEOUT_MS=120000
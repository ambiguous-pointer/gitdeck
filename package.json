{
  "name": "gitdeck",
  "version": "0.1.0",
  "private": true,
  "description": "GitDeck — a production-grade, cross-platform web Git GUI (pnpm monorepo)",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm build:shared && concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @gitdeck/server dev\" \"pnpm --filter @gitdeck/web dev\"",
    "dev:server": "pnpm build:shared && pnpm --filter @gitdeck/server dev",
    "dev:web": "pnpm build:shared && pnpm --filter @gitdeck/web dev",
    "build:shared": "pnpm --filter @gitdeck/shared build",
    "build": "pnpm build:shared && pnpm --filter @gitdeck/server build && pnpm --filter @gitdeck/web build",
    "start": "pnpm --filter @gitdeck/server start",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm test",
    "seed": "node scripts/seed-demo.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean",
    "smoke": "node scripts/smoke-api.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  }
}
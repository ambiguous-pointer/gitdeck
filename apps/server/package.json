{
  "name": "@gitdeck/server",
  "version": "0.1.0",
  "private": true,
  "description": "GitDeck HTTP API server (Express + git CLI)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @gitdeck/shared build && vitest run --config src/test/vitest.config.mts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:sea": "tsup --config tsup.sea.config.ts"
  },
  "dependencies": {
    "@gitdeck/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}